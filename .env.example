# Vorlage für die Umgebungsvariablen. Kopieren nach `.env` und bei Bedarf anpassen.
# Alle Werte hier sind Demo-Werte für den lokalen Betrieb – keine echten Geheimnisse eintragen.

# --- Datenbank ---------------------------------------------------------------
# Lokal (npm run dev, Tests) gegen den db-Container auf localhost:5432.
# In Docker Compose überschreibt docker-compose.yml den Host auf „db“.
POSTGRES_USER=berichtsheft
POSTGRES_PASSWORD=berichtsheft
POSTGRES_DB=berichtsheft
DATABASE_URL=postgresql://berichtsheft:berichtsheft@localhost:5432/berichtsheft
# Eigene Datenbank für die Vitest-Datenbanktests (wird von den Tests migriert und geleert).
TEST_DATABASE_URL=postgresql://berichtsheft:berichtsheft@localhost:5432/berichtsheft_test

# --- App ---------------------------------------------------------------------
# Öffentliche Adresse der App, so wie der Browser sie aufruft.
APP_URL=http://localhost:3000
TZ=Europe/Berlin

# --- Anmeldung (Auth.js, OpenID Connect) -------------------------------------
# Geheimnis zum Signieren der Sitzungs-Cookies. Für echte Umgebungen neu erzeugen:
#   npx auth secret   oder   openssl rand -base64 32
AUTH_SECRET=demo-secret-nur-fuer-lokalen-betrieb-aendern
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Aussteller-URL des Identity Providers, so wie der Browser ihn erreicht.
#   Demo:     http://localhost:8080/realms/berichtsheft  (Keycloak)
#   Produktiv: https://login.microsoftonline.com/<tenant-id>/v2.0  (Entra ID)
AUTH_OIDC_ISSUER=http://localhost:8080/realms/berichtsheft
# Optional: interne Adresse des Identity Providers für Server-zu-Server-Aufrufe
# (Discovery, Token, Schlüssel). Nur nötig, wenn der Server den IdP unter einer
# anderen Adresse erreicht als der Browser, z. B. in Docker Compose: http://keycloak:8080
AUTH_OIDC_INTERNAL_ISSUER=
AUTH_OIDC_CLIENT_ID=berichtsheft-app
AUTH_OIDC_CLIENT_SECRET=berichtsheft-demo-secret
# Claim mit der stabilen Konto-ID: Keycloak „sub“, Entra ID „oid“.
AUTH_OIDC_ACCOUNT_ID_CLAIM=sub
# Zuordnung beim ersten Login: Claim mit der E-Mail und Claim, der sie als bestätigt ausweist.
# Über die E-Mail wird nur zugeordnet, wenn der Bestätigungs-Claim „true“ ist; danach zählt nur die Konto-ID.
#   Keycloak:  AUTH_OIDC_EMAIL_CLAIM=email, AUTH_OIDC_EMAIL_VERIFIED_CLAIM=email_verified
#   Entra ID:  AUTH_OIDC_EMAIL_CLAIM=email, AUTH_OIDC_EMAIL_VERIFIED_CLAIM=xms_edov
#              (optionales Claim in der App-Registrierung unter „Tokenkonfiguration“ hinzufügen)
AUTH_OIDC_EMAIL_CLAIM=email
AUTH_OIDC_EMAIL_VERIFIED_CLAIM=email_verified
# Anzeigename des Login-Knopfs.
AUTH_OIDC_NAME=Firmenkonto
# Test-Login ohne Identity Provider: nur für Entwicklung und Tests ohne Keycloak.
# Wirkt ausschließlich, wenn NODE_ENV nicht „production“ ist.
AUTH_TEST_LOGIN=false

# --- Uhr ---------------------------------------------------------------------
# Optional: feste Uhrzeit für Demo und Tests (ISO-8601), z. B. 2026-10-12T09:00:00+02:00.
# Wirkt nur außerhalb von NODE_ENV=production. Leer = echte Uhrzeit.
APP_FIXED_NOW=

# --- E-Mail (ab Etappe 6) -----------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=berichtsheft@example.test

# --- Docker Compose: veröffentlichte Ports auf dem Rechner --------------------
APP_PORT=3000
DB_PORT=5432
KEYCLOAK_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
