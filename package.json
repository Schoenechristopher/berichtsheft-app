{
  "name": "berichtsheft-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "erinnerung": "tsx src/worker/run-reminders.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "pdf:beispiel": "PDF_BEISPIEL_DIR=beispiel-pdf vitest run --project unit src/pdf/beispiel-pdf.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "ak:abdeckung": "tsx scripts/ak-abdeckung/index.ts",
    "pruefumfang": "node scripts/pruefumfang/index.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-pdf/renderer": "^4.9.0",
    "dotenv": "^18.0.5",
    "feiertagejs": "^1.5.1",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5"
  }
}
